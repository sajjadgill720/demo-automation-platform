# DataQuartz Platform Frontend Environment Configuration
# Copy this to .env (for local development) or set in Vercel Project Settings > Environment Variables

# Portal authentication password (for internal dashboard / team access)
PORTAL_PASSWORD=admin123

# Client-facing Vapi Credentials (prefixed with VITE_)
# Your Vapi Public Key (find this in the Vapi dashboard under Account > Keys)
VITE_VAPI_PUBLIC_KEY=c7b23d50-d419-4727-87a6-58b0912c701f

# The baseline assistant ID used as a fallback
VITE_VAPI_ASSISTANT_ID=dummy-vapi-assistant-id

# Backend API base URL:
# For local dev: http://localhost:8000
# For Vercel production: https://demo-automation-platform.onrender.com
VITE_API_BASE_URL=https://demo-automation-platform.onrender.com

# Cloudflare Turnstile site key (Vite client)
# Test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Nitro Preset (ensures Vercel Build Output API v3 is generated)
NITRO_PRESET=vercel

# Optional: Slack incoming webhook for form alert notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
