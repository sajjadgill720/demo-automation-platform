# DataQuartz Platform Frontend Environment Configuration

# Portal authentication password
PORTAL_PASSWORD=admin123

# Client-facing Vapi Credentials (prefixed with VITE_)
# Your Vapi Public Key (find this in the Vapi dashboard under Account > Keys)
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here
# The baseline assistant ID used as a fallback if dynamic provisioning is skipped
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Backend API base URL (where the React/Vite app sends request data)
VITE_API_BASE_URL=http://localhost:8000


