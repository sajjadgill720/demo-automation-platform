# DataQuartz API Environment Configuration Example

# Server configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres.xxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db_name>

# Vapi API Configuration
# Your Vapi Private Key (Server-side ONLY, never share the public key)
VAPI_API_KEY=930a57e3-077b-4a93-97dc-b786aa05f602

# CORS origins allowed to access the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8080
